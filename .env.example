# Everything here is OPTIONAL. The app runs with no configuration at all:
# the first person to open /admin chooses the admin code from the screen, and
# the session signing key is generated and stored on first boot.

# Set this only if you want the code fixed by the server instead of chosen in
# the app — useful for automated deployments, or to recover access. When set it
# overrides the code stored in the database, and the in-app "change code" is
# disabled.
# ADMIN_PASSWORD=

# Set this on a multi-instance deployment so every instance signs sessions with
# the same key. On a single instance the generated one is fine.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Where the rate and cost tables live. Defaults to ./data/calculator.db
# DATABASE_PATH=/var/lib/forest/calculator.db
