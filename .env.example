# Password for the admin module. Anyone can build quotes; only this password
# unlocks the cost tables, monthly premiums and KC price entry.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional. Defaults to ./data/calculator.db
# DATABASE_PATH=/var/lib/forest/calculator.db
